{
  "manifest_version": 1,
  "id": "aw-app-portrait",
  "name": "AI Portrait",
  "version": "0.5.1",
  "description": "Turn a tablet into a living AI photo frame: meet the people in front of its camera, organize their portraits, and place friends and family in delightful new scenes.",
  "tier": "inprocess",
  "requires_ui_refresh": true,
  "publisher": "TekFlox",
  "resource_estimate": {
    "cpu": "medium",
    "memory": "medium",
    "disk": "medium"
  },
  "runtime": {
    "python": ">=3.11",
    "entrypoint": "portrait_app.plugin:PortraitAppPlugin",
    "pip_requires": [
      "httpx>=0.27",
      "python-multipart>=0.0.9",
      "opencv-python-headless>=4.10,<5",
      "numpy>=1.26,<3"
    ],
    "standalone": {
      "module": "portrait_app",
      "default_port": 9475
    }
  },
  "permissions": [
    "fs:workspace-data",
    "routes:register",
    "net:outbound"
  ],
  "contributes": {
    "routes": [
      {
        "prefix": "/api/apps/aw-app-portrait"
      }
    ],
    "windows": [
      {
        "id": "aw-app-portrait.main",
        "title": "AI Portrait",
        "icon": "camera",
        "body": {
          "type": "managed_app",
          "kind": "web",
          "path": "/"
        }
      }
    ]
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "gallery_base_url": {
        "type": "string",
        "default": "https://agents-platform-multitenant.app.aw.tekflox.com",
        "title": "Agents Platform URL",
        "description": "Optional public URL override. Gallery access is initialized automatically through Agents Platform Runners."
      },
      "bot_slug": {
        "type": "string",
        "default": "portrait",
        "title": "Gallery bot slug"
      },
      "capture_interval_seconds": {
        "type": "integer",
        "minimum": 3,
        "maximum": 300,
        "default": 12,
        "title": "Capture interval (seconds)"
      },
      "openai_api_key": {
        "type": "string",
        "default": "",
        "title": "OpenAI API key",
        "description": "Optional. Enables image generation with reference portraits."
      },
      "image_model": {
        "type": "string",
        "default": "gpt-image-1.5",
        "title": "Image model"
      }
    },
    "required": []
  },
  "config_visible": true,
  "dependencies": {
    "apps": [
      {
        "id": "agents-platform-runners",
        "required": true,
        "reason": "Provides the trusted Agents Platform identity used to initialize and renew this app's gallery access automatically."
      }
    ]
  },
  "migrations": {}
}
